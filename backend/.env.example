# Application
APP_NAME=Linux Copilot XAI
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./linux_copilot.db

# CORS (comma separated origins, use * for all)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Logging
LOG_LEVEL=INFO

# Ollama (local LLM) - used by the AI Ops Assistant
# Install Ollama from https://ollama.com and run: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.2

# AI Assistant behavior
ASSISTANT_HISTORY_TURNS=6
ASSISTANT_MAX_HISTORY_STORED=50

# Script Generator behavior
SCRIPT_GENERATOR_MAX_HISTORY_STORED=20

# Safe Command Execution behavior
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MAX_OUTPUT_CHARS=20000
EXECUTION_MAX_HISTORY_STORED=100

# --- Shared system thresholds ---
# Used by the AI One-Click Fix Engine for High CPU / High Memory / Disk
# Almost Full detection.
ALERT_CPU_THRESHOLD_PERCENT=90
ALERT_MEMORY_THRESHOLD_PERCENT=90
ALERT_DISK_THRESHOLD_PERCENT=90

# --- Sprint 8: AI One-Click Fix Engine ---
FIX_APACHE_SERVICE_NAME=apache2